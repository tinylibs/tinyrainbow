{
  "name": "tinyrainbow",
  "version": "3.1.0",
  "packageManager": "pnpm@10.34.5",
  "description": "A small library to print colourful messages.",
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "format": "prettier --write src tests",
    "test": "vitest run"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "browser": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "types": "./dist/index.d.ts",
    "default": "./dist/index.js"
  },
  "files": [
    "dist/**"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tinylibs/tinyrainbow.git"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/tinylibs/tinyrainbow/issues"
  },
  "homepage": "https://github.com/tinylibs/tinyrainbow#readme",
  "devDependencies": {
    "@size-limit/preset-small-lib": "^13.0.2",
    "@size-limit/time": "^13.0.2",
    "@types/node": "^26.1.2",
    "clean-publish": "^7.1.0",
    "nano-staged": "^1.0.2",
    "playwright": "^1.62.0",
    "prettier": "^3.9.6",
    "size-limit": "^13.0.2",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "keywords": [
    "colors",
    "tty"
  ],
  "engines": {
    "node": ">=14.0.0"
  }
}

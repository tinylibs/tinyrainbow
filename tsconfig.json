{
  "compilerOptions": {
    "rootDir": "./",
    // tsup injects `baseUrl` during the dts build, which TypeScript 6 reports as deprecated
    "ignoreDeprecations": "6.0",
    "module": "node18",
    "target": "esnext",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true
  },
  "include": ["src/**/*", "tests/**/*"]
}
